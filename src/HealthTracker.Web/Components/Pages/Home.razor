@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HealthTrackerService Tracker
@inject IDialogService DialogService

<PageTitle>Dashboard · HealthPulse</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-5 page-header">
    <div><MudText Typo="Typo.h3">Your health, at a glance</MudText><MudText Color="MudBlazor.Color.Secondary">Track the measurements that matter to you.</MudText></div>
    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="OpenAddDialogAsync" Disabled="@(templates.Count == 0)">Add reading</MudButton>
</MudStack>
@if (loading) { <MudProgressCircular Indeterminate="true" /> }
else if (templates.Count == 0) { <MudAlert Severity="Severity.Info">You are not tracking anything yet. Visit Templates to select a measurement.</MudAlert> }
else
{
    <MudGrid Class="mb-5">@foreach (var template in templates) { var summary = summaries.FirstOrDefault(x => x.TemplateId == template.Id); <MudItem xs="12" sm="6" md="4"><MudPaper Class="pa-4 metric-card" Elevation="0"><MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">@template.Name</MudText>@if (summary is null) { <MudText Typo="Typo.h6" Class="mt-3">No readings yet</MudText> } else { <MudText Typo="Typo.h4" Class="mt-2">@summary.LatestValue.ToString("0.##") <small>@summary.Unit</small></MudText><MudText Typo="Typo.caption">@summary.RecordedAtUtc.ToLocalTime().ToString("g")</MudText><MudChip T="string" Size="MudBlazor.Size.Small" Class="mt-2" Color="@(summary.ChangeFromPrevious is > 0 ? MudBlazor.Color.Warning : MudBlazor.Color.Success)">@(summary.ChangeFromPrevious is null ? "First reading" : $"{summary.ChangeFromPrevious.Value:+0.##;-0.##;0} {summary.Unit}")</MudChip> }</MudPaper></MudItem> }</MudGrid>
    <MudPaper Class="pa-5" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 chart-controls"><MudSelect T="Guid" Label="Metric" Dense="true" @bind-Value="selectedTemplateId" @bind-Value:after="LoadChartAsync" Style="min-width: 220px">@foreach (var template in ChartTemplates) { <MudSelectItem Value="template.Id">@template.Name</MudSelectItem> }</MudSelect><MudButtonGroup Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"><MudButton OnClick="() => SetRangeAsync(7)">7 days</MudButton><MudButton OnClick="() => SetRangeAsync(30)">30 days</MudButton><MudButton OnClick="() => SetRangeAsync(90)">90 days</MudButton><MudButton OnClick="() => SetRangeAsync(365)">Year</MudButton></MudButtonGroup><MudCheckBox T="bool" @bind-Value="showArchived" @bind-Value:after="LoadAllAsync" Label="Include archived" /></MudStack>
        @if (chartReadings.Count == 0) { <MudAlert Severity="Severity.Info">No readings in this time range.</MudAlert> } else { <ApexCharts.ApexChart @key="selectedTemplateId" TItem="ReadingDto" Title="@($"{SelectedTemplate?.Name} over time")" Options="chartOptions"><ApexCharts.ApexPointSeries TItem="ReadingDto" Items="chartReadings" Name="@(SelectedTemplate?.NormalizedUnit ?? "Value")" SeriesType="ApexCharts.SeriesType.Line" XValue="reading => reading.RecordedAtUtc.DateTime" YValue="reading => reading.Value" /></ApexCharts.ApexChart> }
    </MudPaper>
}
@code {
    private readonly ApexCharts.ApexChartOptions<ReadingDto> chartOptions = new() { Chart = new ApexCharts.Chart { Toolbar = new ApexCharts.Toolbar { Show = true } }, Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Smooth }, Xaxis = new ApexCharts.XAxis { Type = ApexCharts.XAxisType.Datetime } };
    private IReadOnlyCollection<TemplateDto> templates = Array.Empty<TemplateDto>(); private IReadOnlyCollection<TemplateDto> catalogue = Array.Empty<TemplateDto>(); private IReadOnlyCollection<MetricSummaryDto> summaries = Array.Empty<MetricSummaryDto>(); private IReadOnlyCollection<ReadingDto> chartReadings = Array.Empty<ReadingDto>(); private Guid selectedTemplateId; private int rangeDays = 90; private bool showArchived; private bool loading = true;
    private IEnumerable<TemplateDto> ChartTemplates => showArchived ? catalogue : templates; private TemplateDto? SelectedTemplate => ChartTemplates.FirstOrDefault(x => x.Id == selectedTemplateId);
    protected override async Task OnInitializedAsync() => await LoadAllAsync();
    private async Task LoadAllAsync() { loading = true; templates = await Tracker.GetTrackedTemplatesAsync(CancellationToken.None); catalogue = await Tracker.GetCatalogueAsync(CancellationToken.None); summaries = await Tracker.GetMetricSummariesAsync(CancellationToken.None); if (!ChartTemplates.Any(x => x.Id == selectedTemplateId)) selectedTemplateId = ChartTemplates.FirstOrDefault()?.Id ?? Guid.Empty; await LoadChartAsync(); loading = false; }
    private async Task LoadChartAsync() { if (selectedTemplateId == Guid.Empty) { chartReadings = Array.Empty<ReadingDto>(); return; } chartReadings = (await Tracker.GetReadingsAsync(selectedTemplateId, DateTimeOffset.UtcNow.AddDays(-rangeDays), DateTimeOffset.UtcNow, CancellationToken.None)).OrderBy(x => x.RecordedAtUtc).ToArray(); }
    private async Task SetRangeAsync(int days) { rangeDays = days; await LoadChartAsync(); }
    private async Task OpenAddDialogAsync() { var result = await DialogService.ShowAsync<ReadingDialog>("Add reading", new DialogParameters { [nameof(ReadingDialog.Templates)] = templates }); if ((await result.Result)?.Canceled == false) await LoadAllAsync(); }
}
