@page "/readings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HealthTrackerService Tracker
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Readings · HealthPulse</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 page-header"><div><MudText Typo="Typo.h3">Readings</MudText><MudText Color="MudBlazor.Color.Secondary">Review, correct, or remove your health data.</MudText></div><MudButton StartIcon="@Icons.Material.Filled.Add" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="AddAsync">Add reading</MudButton></MudStack>
<MudPaper Class="pa-4 mb-4" Elevation="0"><MudGrid><MudItem xs="12" md="4"><MudSelect T="Guid?" Label="Measurement" Clearable="true" @bind-Value="templateId" @bind-Value:after="ResetAndLoadAsync">@foreach (var template in templates) { <MudSelectItem Value="@((Guid?)template.Id)">@template.Name</MudSelectItem> }</MudSelect></MudItem><MudItem xs="12" md="3"><MudDatePicker Label="From" @bind-Date="from" @bind-Date:after="ResetAndLoadAsync" /></MudItem><MudItem xs="12" md="3"><MudDatePicker Label="To" @bind-Date="to" @bind-Date:after="ResetAndLoadAsync" /></MudItem><MudItem xs="12" md="2"><MudButton FullWidth="true" Class="mt-4" Variant="Variant.Outlined" OnClick="ClearFiltersAsync">Clear</MudButton></MudItem></MudGrid></MudPaper>
@if (page is null) { <MudProgressCircular Indeterminate="true" /> }
else if (page.Items.Count == 0) { <MudAlert Severity="Severity.Info">No readings match these filters.</MudAlert> }
else { <MudTable Items="@(page.Items)" Dense="true" Hover="true"><HeaderContent><MudTh>Measurement</MudTh><MudTh>Value</MudTh><MudTh>Recorded</MudTh><MudTh>Note</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd DataLabel="Measurement">@context.TemplateName</MudTd><MudTd DataLabel="Value">@context.Value.ToString("0.##") @context.Unit</MudTd><MudTd DataLabel="Recorded">@context.RecordedAtUtc.ToLocalTime().ToString("g")</MudTd><MudTd DataLabel="Note">@context.Note</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit reading" OnClick="() => EditAsync(context)" /><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="MudBlazor.Color.Error" aria-label="Delete reading" OnClick="() => DeleteAsync(context)" /></MudTd></RowTemplate></MudTable><MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3"><MudText Typo="Typo.body2">@(page.TotalCount) reading(s)</MudText><MudPagination Count="@TotalPages" Selected="currentPage" SelectedChanged="SelectPageAsync" /></MudStack> }

@code {
    private IReadOnlyCollection<TemplateDto> templates = Array.Empty<TemplateDto>(); private ReadingPageDto? page; private Guid? templateId; private DateTime? from; private DateTime? to; private int currentPage = 1; private const int PageSize = 15; private int TotalPages => Math.Max(1, (int)Math.Ceiling((page?.TotalCount ?? 0) / (double)PageSize));
    protected override async Task OnInitializedAsync() { templates = await Tracker.GetCatalogueAsync(CancellationToken.None); await LoadAsync(); }
    private async Task LoadAsync() => page = await Tracker.GetReadingPageAsync(templateId, ToUtc(from, false), ToUtc(to, true), currentPage, PageSize, CancellationToken.None);
    private async Task ResetAndLoadAsync() { currentPage = 1; await LoadAsync(); }
    private async Task SelectPageAsync(int value) { currentPage = value; await LoadAsync(); }
    private async Task ClearFiltersAsync() { templateId = null; from = null; to = null; await ResetAndLoadAsync(); }
    private async Task AddAsync() { var tracked = await Tracker.GetTrackedTemplatesAsync(CancellationToken.None); var result = await DialogService.ShowAsync<ReadingDialog>("Add reading", new DialogParameters { [nameof(ReadingDialog.Templates)] = tracked }); if ((await result.Result)?.Canceled == false) await ResetAndLoadAsync(); }
    private async Task EditAsync(ReadingDto reading) { var template = templates.FirstOrDefault(x => x.Id == reading.TemplateId); if (template is null) return; var result = await DialogService.ShowAsync<ReadingDialog>("Edit reading", new DialogParameters { [nameof(ReadingDialog.Templates)] = new[] { template }, [nameof(ReadingDialog.Reading)] = reading }); if ((await result.Result)?.Canceled == false) await LoadAsync(); }
    private async Task DeleteAsync(ReadingDto reading) { var confirmed = await DialogService.ShowMessageBox("Remove reading?", $"Remove the {reading.TemplateName} reading from {reading.RecordedAtUtc.ToLocalTime():g}? It will be retained for 60 days.", yesText: "Remove", cancelText: "Cancel"); if (confirmed == true) { await Tracker.DeleteReadingAsync(reading.Id, CancellationToken.None); Snackbar.Add("Reading removed.", Severity.Success); await LoadAsync(); } }
    private static DateTimeOffset? ToUtc(DateTime? value, bool endOfDay) => value is null ? null : new DateTimeOffset(endOfDay ? value.Value.Date.AddDays(1).AddTicks(-1) : value.Value.Date, TimeZoneInfo.Local.GetUtcOffset(value.Value)).ToUniversalTime();
}
