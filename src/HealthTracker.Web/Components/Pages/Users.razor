@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Administrator")]
@inject HealthTrackerService Tracker
@inject PersonalAccessTokenService TokenService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>User management · HealthPulse</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h3">User management</MudText>
        <MudText Color="MudBlazor.Color.Secondary">Control who can access HealthPulse.</MudText>
    </div>
    <MudCheckBox T="bool" @bind-Value="showArchived" @bind-Value:after="LoadAsync" Label="Show archived" />
</MudStack>

<MudPaper Class="pa-4 mb-5" Elevation="0">
    <MudText Typo="Typo.h6">Add user</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" md="7"><MudTextField Label="Google email address" @bind-Value="email" Required="true" /></MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" Label="Role" @bind-Value="role">
                <MudSelectItem Value="@("Member")">Member</MudSelectItem>
                <MudSelectItem Value="@("Admin")">Administrator</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2"><MudButton FullWidth="true" Class="mt-4" Color="MudBlazor.Color.Primary" OnClick="AddAsync">Add user</MudButton></MudItem>
    </MudGrid>
</MudPaper>

@if (users is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="users" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Email</MudTh><MudTh>Role</MudTh><MudTh>Status</MudTh><MudTh>First sign-in</MudTh><MudTh>Last sign-in</MudTh><MudTh>Access tokens</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Role">
                @if (context.IsArchived)
                {
                    @context.Role
                }
                else
                {
                    <MudSelect T="string" Value="context.Role" ValueChanged="value => ChangeRoleAsync(context, value)" Dense="true">
                        <MudSelectItem Value="@("Member")">Member</MudSelectItem>
                        <MudSelectItem Value="@("Admin")">Administrator</MudSelectItem>
                    </MudSelect>
                }
            </MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="MudBlazor.Size.Small" Color="@StatusColor(context)">@Status(context)</MudChip></MudTd>
            <MudTd DataLabel="First sign-in">@FormatDate(context.FirstSignedInUtc)</MudTd>
            <MudTd DataLabel="Last sign-in">@FormatDate(context.LastSignedInUtc)</MudTd>
            <MudTd DataLabel="Access tokens">
                @if (userTokens.TryGetValue(context.Id, out var tokens))
                {
                    @foreach (var token in tokens.Where(x => !x.IsRevoked))
                    {
                        <MudChip T="string" Size="MudBlazor.Size.Small" Class="mr-1">@token.Name <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Block" aria-label="Revoke token" OnClick="() => RevokeTokenAsync(context.Id, token.Id)" /></MudChip>
                    }
                }
            </MudTd>
            <MudTd>
                @if (context.IsArchived)
                {
                    <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary" OnClick="() => ReactivateAsync(context)">Reactivate</MudButton>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="MudBlazor.Color.Error" aria-label="Archive user" OnClick="() => ArchiveAsync(context)" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyCollection<AllowedUserDto>? users;
    private string email = string.Empty;
    private string role = "Member";
    private bool showArchived;
    private Dictionary<Guid, IReadOnlyCollection<PersonalAccessTokenDto>> userTokens = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        users = await Tracker.GetAllowedUsersAsync(showArchived, CancellationToken.None);
        userTokens = [];
        foreach (var user in users)
        {
            userTokens[user.Id] = await TokenService.GetTokensForUserAsync(user.Id, CancellationToken.None);
        }
    }

    private async Task AddAsync()
    {
        try
        {
            await Tracker.AddAllowedUserAsync(new AddAllowedUserDto(email, role), CancellationToken.None);
            email = string.Empty;
            role = "Member";
            Snackbar.Add("User saved.", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ChangeRoleAsync(AllowedUserDto user, string value)
    {
        try
        {
            await Tracker.UpdateAllowedUserRoleAsync(
                user.Id,
                new UpdateAllowedUserRoleDto(value),
                CancellationToken.None
            );
            Snackbar.Add("Role updated.", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
    }

    private async Task ArchiveAsync(AllowedUserDto user)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Archive user?",
            $"{user.Email} will no longer be able to sign in. Their health data will be retained.",
            yesText: "Archive",
            cancelText: "Cancel"
        );
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Tracker.ArchiveAllowedUserAsync(user.Id, CancellationToken.None);
            Snackbar.Add("User archived.", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ReactivateAsync(AllowedUserDto user)
    {
        await Tracker.AddAllowedUserAsync(
            new AddAllowedUserDto(user.Email, user.Role),
            CancellationToken.None
        );
        Snackbar.Add("User reactivated.", Severity.Success);
        await LoadAsync();
    }

    private async Task RevokeTokenAsync(Guid userId, Guid tokenId)
    {
        await TokenService.RevokeTokenAsync(tokenId, userId, CancellationToken.None);
        Snackbar.Add("Token revoked.", Severity.Success);
        await LoadAsync();
    }

    private static string Status(AllowedUserDto user) => user.IsArchived
        ? "Archived"
        : user.HasSignedIn
            ? "Active"
            : "Invited";

    private static MudBlazor.Color StatusColor(AllowedUserDto user) => user.IsArchived
        ? MudBlazor.Color.Default
        : user.HasSignedIn
            ? MudBlazor.Color.Success
            : MudBlazor.Color.Info;

    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("g") ?? "—";
}
