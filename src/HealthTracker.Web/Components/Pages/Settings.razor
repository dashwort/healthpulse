@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using HealthTracker.Web.Configuration
@using HealthTracker.Web.Services
@using Microsoft.Extensions.Options
@inject IOptions<DeploymentInfo> Deployment
@inject MobileReleaseService ReleaseService

<PageTitle>App information · HealthPulse</PageTitle>

<MudText Typo="Typo.h3" Class="mb-1">App information</MudText>
<MudText Color="MudBlazor.Color.Secondary" Class="mb-4">Deployment details can help when reporting an issue or confirming an update.</MudText>

<MudPaper Class="pa-5 mb-4" Elevation="0" Style="max-width: 720px">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Android" Color="MudBlazor.Color.Primary" />
            <MudText Typo="Typo.h5">Android app</MudText>
        </MudStack>
        <MudDivider />
        @if (androidRelease is null)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Primary" />
        }
        else if (androidRelease.ApkUrl is not null)
        {
            <MudText>Download the latest Android app directly from the HealthPulse release.</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Href="@androidRelease.ApkUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Download">Download APK</MudButton>
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Version @androidRelease.LatestVersion</MudText>
            </MudStack>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Android may ask you to allow installation from this source.</MudText>
        }
        else
        {
            <MudAlert Severity="Severity.Info">The Android app is not currently available for download.</MudAlert>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-5" Elevation="0" Style="max-width: 720px">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="MudBlazor.Color.Primary" />
            <MudText Typo="Typo.h5">Deployment</MudText>
        </MudStack>
        <MudDivider />
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Version</MudText>
                <MudText Typo="Typo.body1">@info.Version</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Build</MudText>
                <MudText Typo="Typo.body1">@info.Build</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Commit</MudText>
                <MudText Typo="Typo.body1" Style="word-break: break-all"><code>@info.Commit</code></MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Built</MudText>
                <MudText Typo="Typo.body1">@FormattedBuildTime</MudText>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

@code {
    private DeploymentInfo info = default!;
    private MobileAndroidRelease? androidRelease;

    protected override async Task OnInitializedAsync()
    {
        info = Deployment.Value;
        androidRelease = await ReleaseService.GetLatestAsync(CancellationToken.None);
    }

    private string FormattedBuildTime =>
        DateTimeOffset.TryParse(
            info.BuiltAtUtc,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var builtAt
        )
            ? builtAt.ToLocalTime().ToString("f")
            : info.BuiltAtUtc;
}
