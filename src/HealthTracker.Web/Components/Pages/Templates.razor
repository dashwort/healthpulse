@page "/templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HealthTrackerService Tracker
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Templates · HealthPulse</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4"><div><MudText Typo="Typo.h3">Measurement templates</MudText><MudText Color="MudBlazor.Color.Secondary">Choose common measures or make one that is personal to you.</MudText></div><MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="BeginCreate">Custom template</MudButton></MudStack>
@if (editing) { <MudPaper Class="pa-4 mb-5" Elevation="0"><MudText Typo="Typo.h6">@(editingId is null ? "Create custom template" : "Edit custom template")</MudText><MudGrid Class="mt-1"><MudItem xs="12" md="4"><MudTextField Label="Name" @bind-Value="model.Name" Required="true" /></MudItem><MudItem xs="12" md="3"><MudTextField Label="Category" @bind-Value="model.Category" Required="true" /></MudItem><MudItem xs="12" md="3"><MudTextField Label="Unit" @bind-Value="model.Unit" Required="true" HelperText="Custom readings use this exact unit." /></MudItem><MudItem xs="12" md="2"><MudStack Row="true" Class="mt-4"><MudButton Color="MudBlazor.Color.Primary" OnClick="SaveCustomAsync">Save</MudButton><MudButton OnClick="CancelEdit">Cancel</MudButton></MudStack></MudItem></MudGrid></MudPaper> }
@if (templates is null) { <MudProgressCircular Indeterminate="true" /> }
else { <MudTable Items="templates" Dense="true" Hover="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Category</MudTh><MudTh>Units</MudTh><MudTh>Tracking</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd DataLabel="Name">@context.Name @if (context.IsCustom) { <MudChip T="string" Size="MudBlazor.Size.Small">Custom</MudChip> }</MudTd><MudTd DataLabel="Category">@context.Category</MudTd><MudTd DataLabel="Units">@string.Join(", ", context.AllowedUnits)</MudTd><MudTd DataLabel="Tracking"><MudSwitch T="bool" Value="context.IsTracked" ValueChanged="value => ToggleTrackingAsync(context, value)" Color="MudBlazor.Color.Primary" /></MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" Disabled="@(!context.IsCustom)" aria-label="Edit custom template" OnClick="() => BeginEdit(context)" />@if (context.IsCustom) { <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="MudBlazor.Color.Error" aria-label="Delete custom template" OnClick="() => DeleteCustomAsync(context)" /> }</MudTd></RowTemplate></MudTable> }

@code {
    private IReadOnlyCollection<TemplateDto>? templates; private bool editing; private Guid? editingId; private TemplateModel model = new();
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => templates = await Tracker.GetCatalogueAsync(CancellationToken.None);
    private void BeginCreate() { editing = true; editingId = null; model = new TemplateModel(); }
    private void BeginEdit(TemplateDto template) { editing = true; editingId = template.Id; model = new TemplateModel { Name = template.Name, Category = template.Category, Unit = template.NormalizedUnit }; }
    private void CancelEdit() { editing = false; editingId = null; }
    private async Task SaveCustomAsync() { if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.Category) || string.IsNullOrWhiteSpace(model.Unit)) { Snackbar.Add("Name, category, and unit are required.", Severity.Error); return; } if (editingId is null) await Tracker.CreateCustomTemplateAsync(new CreateCustomTemplateDto(model.Name, model.Category, model.Unit), CancellationToken.None); else await Tracker.UpdateCustomTemplateAsync(editingId.Value, new UpdateCustomTemplateDto(model.Name, model.Category, model.Unit), CancellationToken.None); Snackbar.Add("Template saved.", Severity.Success); CancelEdit(); await LoadAsync(); }
    private async Task ToggleTrackingAsync(TemplateDto template, bool enabled) { if (enabled) await Tracker.TrackTemplateAsync(template.Id, CancellationToken.None); else await Tracker.StopTrackingAsync(template.Id, CancellationToken.None); Snackbar.Add(enabled ? "Tracking enabled." : "Tracking stopped. History remains available.", Severity.Success); await LoadAsync(); }
    private async Task DeleteCustomAsync(TemplateDto template) { var confirmed = await DialogService.ShowMessageBox("Delete custom template?", $"{template.Name} and its tracking selection will be soft-deleted. Existing readings remain in your history.", yesText: "Delete", cancelText: "Cancel"); if (confirmed == true) { await Tracker.DeleteCustomTemplateAsync(template.Id, CancellationToken.None); Snackbar.Add("Custom template deleted.", Severity.Success); await LoadAsync(); } }
    private sealed class TemplateModel { public string Name { get; set; } = string.Empty; public string Category { get; set; } = "Custom"; public string Unit { get; set; } = string.Empty; }
}
