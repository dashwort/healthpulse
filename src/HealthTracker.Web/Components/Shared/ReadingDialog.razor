@inject HealthTrackerService Tracker
@inject ISnackbar Snackbar
@inherits OwningComponentBase

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Reading is null ? "Add reading" : "Edit reading")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="form">
            <MudSelect T="Guid" Label="Measurement" @bind-Value="model.TemplateId" Disabled="@(Reading is not null)" Required="true" Class="mb-3">
                @foreach (var template in Templates) { <MudSelectItem Value="template.Id">@template.Name</MudSelectItem> }
            </MudSelect>
            <MudNumericField T="decimal" Label="Value" @bind-Value="model.Value" Required="true" Min="0" Max="1000000" Step="0.1m" Class="mb-3" />
            <MudSelect T="string" Label="Unit" @bind-Value="model.Unit" Required="true" Class="mb-3">
                @foreach (var unit in CurrentTemplate?.AllowedUnits ?? Array.Empty<string>()) { <MudSelectItem Value="unit">@unit</MudSelectItem> }
            </MudSelect>
            <MudDatePicker Label="Date" @bind-Date="date" Class="mb-3" />
            <MudTimePicker Label="Time" @bind-Time="time" AmPm="false" Class="mb-3" />
            <MudTextField Label="Note (optional)" @bind-Value="model.Note" MaxLength="140" Counter="140" Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save reading</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public IReadOnlyCollection<TemplateDto> Templates { get; set; } = Array.Empty<TemplateDto>();
    [Parameter] public ReadingDto? Reading { get; set; }
    private MudForm form = null!;
    private ReadingModel model = new();
    private DateTime? date;
    private TimeSpan? time;
    private TemplateDto? CurrentTemplate => Templates.FirstOrDefault(x => x.Id == model.TemplateId);

    protected override void OnParametersSet()
    {
        if (Reading is not null)
            model = new ReadingModel { TemplateId = Reading.TemplateId, Value = Reading.Value, Unit = Reading.Unit, Note = Reading.Note };
        else if (model.TemplateId == Guid.Empty && Templates.FirstOrDefault() is { } first)
            model = new ReadingModel { TemplateId = first.Id, Unit = first.AllowedUnits.FirstOrDefault() ?? first.NormalizedUnit };
        var local = (Reading?.RecordedAtUtc ?? DateTimeOffset.UtcNow).ToLocalTime();
        date = local.Date;
        time = local.TimeOfDay;
    }

    private async Task SaveAsync()
    {
        await form.Validate();
        if (!form.IsValid || date is null || time is null || CurrentTemplate is null) return;
        var local = new DateTimeOffset(date.Value.Date.Add(time.Value), TimeZoneInfo.Local.GetUtcOffset(date.Value.Date.Add(time.Value))).ToUniversalTime();
        try
        {
            if (Reading is null) await Tracker.CreateReadingAsync(new CreateReadingDto(model.TemplateId, model.Value, model.Unit, local, model.Note), CancellationToken.None);
            else await Tracker.UpdateReadingAsync(Reading.Id, new UpdateReadingDto(model.Value, model.Unit, local, model.Note), CancellationToken.None);
            Snackbar.Add("Reading saved.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
    private void Cancel() => Dialog.Cancel();
    private sealed class ReadingModel { public Guid TemplateId { get; set; } public decimal Value { get; set; } public string Unit { get; set; } = string.Empty; public string? Note { get; set; } }
}
