{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "Information",
      "Microsoft.AspNetCore.SignalR": "Information",
      "HealthTracker": "Information"
    },
    "File": {
      "RetentionDays": 14,
      "MaximumFileSizeBytes": 10485760
    }
  },
  "AllowedHosts": "*"
}
