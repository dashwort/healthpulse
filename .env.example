ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AccessControl__InitialAdministratorEmail=admin@example.com
Authentication__OpenIdConnect__Authority=https://accounts.google.com
Authentication__OpenIdConnect__ClientId=your-client-id.apps.googleusercontent.com
Authentication__OpenIdConnect__ClientSecret=store-this-outside-git
Authentication__OpenIdConnect__CallbackPath=/signin-oidc
Authentication__OpenIdConnect__Scopes__0=openid
Authentication__OpenIdConnect__Scopes__1=profile
Authentication__OpenIdConnect__Scopes__2=email
ConnectionStrings__HealthTracker=Data Source=/app/App_Data/healthtracker.db
# Docker network CIDRs used only by the cloudflared tunnel, for example 172.20.0.0/16.
# Leave empty when the app is not behind a trusted proxy; CF-Connecting-IP will then be ignored.
AccessActivity__TrustedProxyNetworks__0=
# Android release settings. The APK is published by the Android release workflow.
Mobile__Android__LatestVersion=
Mobile__Android__ApkUrl=
Mobile__Android__ReleaseNotes=
Mobile__Android__ReleaseRepository=dashwort/healthpulse
